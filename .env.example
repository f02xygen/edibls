# Telegram Bot Token (from @BotFather) - REQUIRED
TELOXIDE_TOKEN=your_telegram_bot_token_here

# Yandex Music OAuth Token (optional, needed for Yandex Music links)
YANDEX_MUSIC_TOKEN=

# Max concurrent downloads across all users (default: 3)
MAX_CONCURRENT_DOWNLOADS=3

# Path to cookies file for yt-dlp (optional)
COOKIES_PATH=cookies.txt

# YouTube PO token provider URL (optional, e.g. for bgutil-ytdlp-pot-provider)
# When running with docker-compose: http://pot-provider:4416/get_pot
YOUTUBE_POT_URL=http://pot-provider:4416/get_pot

# Custom path to yandex-music-downloader binary (optional)
# Defaults to searching ./venv/bin/yandex-music-downloader or system PATH
# YANDEX_DOWNLOADER_BIN=yandex-music-downloader
